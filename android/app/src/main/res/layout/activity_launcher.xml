<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center" android:orientation="vertical" android:padding="24dp">
    <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:id="@+id/error_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:gravity="center" android:visibility="gone" android:textAppearance="?attr/textAppearanceBodyLarge" />
    <Button android:id="@+id/retry" style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="@string/retry" android:visibility="gone" />
</LinearLayout>
