<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FF0B1214">

    <!-- Remote video fills the screen (black until the other side sends video). -->
    <org.webrtc.SurfaceViewRenderer android:id="@+id/remote"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <!-- Own camera preview, small, top-end corner. Hidden for voice calls. -->
    <org.webrtc.SurfaceViewRenderer android:id="@+id/local"
        android:layout_width="112dp" android:layout_height="150dp"
        android:layout_gravity="top|end" android:layout_margin="16dp"
        android:layout_marginTop="56dp" android:visibility="gone" />

    <!-- Name, status / timer -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top" android:layout_marginTop="48dp" android:gravity="center_horizontal"
        android:orientation="vertical" android:paddingHorizontal="24dp">
        <ImageView android:id="@+id/big_avatar" android:layout_width="120dp" android:layout_height="120dp"
            android:scaleType="centerCrop" android:contentDescription="@null" />
        <TextView android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:textColor="#FFFFFFFF" android:textSize="24sp"
            android:textStyle="bold" />
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textColor="#CCFFFFFF" android:textSize="16sp" />
    </LinearLayout>

    <!-- Incoming call: accept or decline -->
    <LinearLayout android:id="@+id/incoming" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:layout_marginBottom="130dp" android:orientation="horizontal"
        android:paddingHorizontal="32dp" android:visibility="gone">
        <com.google.android.material.button.MaterialButton android:id="@+id/decline"
            android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1"
            android:layout_marginEnd="12dp" android:text="@string/call_decline"
            app:backgroundTint="#FFD32F2F" app:icon="@drawable/ic_call_end" app:iconTint="#FFFFFFFF" app:cornerRadius="30dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/accept"
            android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1"
            android:layout_marginStart="12dp" android:text="@string/call_accept"
            app:backgroundTint="#FF15803D" app:icon="@drawable/ic_call" app:iconTint="#FFFFFFFF" app:cornerRadius="30dp" />
    </LinearLayout>

    <!-- In-call controls -->
    <LinearLayout android:id="@+id/controls" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:layout_marginBottom="28dp" android:gravity="center"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/mic"
            android:layout_width="56dp" android:layout_height="56dp" android:layout_marginHorizontal="6dp"
            android:contentDescription="@string/call_mute" android:minWidth="0dp" android:padding="0dp"
            app:backgroundTint="#33FFFFFF" app:cornerRadius="28dp" app:icon="@drawable/ic_mic"
            app:iconGravity="textStart" app:iconPadding="0dp" app:iconSize="24dp" app:iconTint="#FFFFFFFF" />
        <com.google.android.material.button.MaterialButton android:id="@+id/cam"
            android:layout_width="56dp" android:layout_height="56dp" android:layout_marginHorizontal="6dp"
            android:contentDescription="@string/call_camera" android:minWidth="0dp" android:padding="0dp"
            app:backgroundTint="#33FFFFFF" app:cornerRadius="28dp" app:icon="@drawable/ic_video"
            app:iconGravity="textStart" app:iconPadding="0dp" app:iconSize="24dp" app:iconTint="#FFFFFFFF" />
        <com.google.android.material.button.MaterialButton android:id="@+id/flip"
            android:layout_width="56dp" android:layout_height="56dp" android:layout_marginHorizontal="6dp"
            android:contentDescription="@string/call_flip" android:minWidth="0dp" android:padding="0dp"
            app:backgroundTint="#33FFFFFF" app:cornerRadius="28dp" app:icon="@drawable/ic_flip"
            app:iconGravity="textStart" app:iconPadding="0dp" app:iconSize="24dp" app:iconTint="#FFFFFFFF" />
        <com.google.android.material.button.MaterialButton android:id="@+id/speaker"
            android:layout_width="56dp" android:layout_height="56dp" android:layout_marginHorizontal="6dp"
            android:contentDescription="@string/call_speaker" android:minWidth="0dp" android:padding="0dp"
            app:backgroundTint="#33FFFFFF" app:cornerRadius="28dp" app:icon="@drawable/ic_speaker"
            app:iconGravity="textStart" app:iconPadding="0dp" app:iconSize="24dp" app:iconTint="#FFFFFFFF" />
        <com.google.android.material.button.MaterialButton android:id="@+id/end"
            android:layout_width="64dp" android:layout_height="64dp" android:layout_marginHorizontal="6dp"
            android:contentDescription="@string/call_end" android:minWidth="0dp" android:padding="0dp"
            app:backgroundTint="#FFD32F2F" app:cornerRadius="32dp" app:icon="@drawable/ic_call_end"
            app:iconGravity="textStart" app:iconPadding="0dp" app:iconSize="28dp" app:iconTint="#FFFFFFFF" />
    </LinearLayout>
</FrameLayout>
