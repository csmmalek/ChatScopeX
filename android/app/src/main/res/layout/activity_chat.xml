<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back" app:titleTextAppearance="?attr/textAppearanceTitleMedium" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:background="@drawable/chat_wallpaper">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/list"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingTop="10dp" android:paddingBottom="10dp" />
        <TextView android:id="@+id/empty" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:padding="32dp" android:gravity="center"
            android:text="@string/chat_empty"
            android:visibility="gone" android:textAppearance="?attr/textAppearanceBodyLarge" />
    </FrameLayout>

    <!-- Input bar: rounded field + round send button -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="bottom" android:orientation="horizontal"
        android:paddingHorizontal="10dp" android:paddingVertical="8dp"
        android:background="?attr/colorSurface" android:elevation="4dp">
        <ImageButton android:id="@+id/attach" android:layout_width="44dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/attach_image"
            android:src="@drawable/ic_attach" android:tint="?attr/colorPrimary" />
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            app:boxCornerRadiusBottomEnd="26dp" app:boxCornerRadiusBottomStart="26dp"
            app:boxCornerRadiusTopEnd="26dp" app:boxCornerRadiusTopStart="26dp"
            app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp"
            app:hintEnabled="false">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/input"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@null" android:hint="@string/message_hint"
                android:inputType="textMultiLine|textCapSentences" android:maxLength="4000"
                android:maxLines="5" android:paddingHorizontal="16dp" android:paddingVertical="10dp" />
        </com.google.android.material.textfield.TextInputLayout>
        <ImageButton android:id="@+id/mic" android:layout_width="44dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/record_voice"
            android:src="@drawable/ic_mic" android:tint="?attr/colorPrimary" />
        <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/send"
            android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp"
            android:contentDescription="@string/send" app:fabSize="mini" app:srcCompat="@drawable/ic_send"
            app:tint="?attr/colorOnPrimary" />
    </LinearLayout>
</LinearLayout>
