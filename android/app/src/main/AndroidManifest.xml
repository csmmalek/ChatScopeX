<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Calls: microphone always, camera only for video calls (asked at call time, not at install). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- allowBackup=false: keeps the local Firestore cache out of cloud/device backups -->
    <application
        android:name=".ChatScopeXApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChatScopeX">

        <activity android:name=".ui.LauncherActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.LoginActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.ProfileSetupActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.MainActivity" android:exported="false" />
        <activity android:name=".ui.UserSearchActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.ChatActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.GroupCreateActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.GroupInfoActivity" android:exported="false" />
        <activity android:name=".ui.StatusComposerActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.StatusViewActivity" android:exported="false" />
        <!-- Portrait only: a rotation would recreate the screen and interrupt the call setup. -->
        <activity android:name=".ui.CallActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:supportsPictureInPicture="false" />
    </application>
</manifest>
